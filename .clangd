# Compile flags come from compile_commands.json (generated by CMake). Point
# clangd at the default build dir (make uses CC=clang on macOS,
# BUILD_TYPE=debug -> build-clang-debug); `make compile-db` also symlinks
# the DB to the repo root for other setups.
#
# clang-tidy checks live in .clang-tidy (auto-discovered by clangd), so
# there is no ClangTidy block here — one source of truth for editor and CLI.
CompileFlags:
  CompilationDatabase: build-clang-debug
